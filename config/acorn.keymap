#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&lt {
    // Activate Raise when another key is pressed and released while Escape is held.
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    macros {
        bt_clear: bt_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        bt_clear_hold: bt_clear_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            // Other key presses must not bypass the one-second hold.
            flavor = "tap-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bt_clear>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
// -----------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | LSHFT|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | RSHFT|
//                    | ALT | GUI | RET |   | SPC | LWR | ESC |
            bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
              &kp LALT &kp LGUI &kp RET   &kp SPACE &mo 1 &lt 2 ESC
            >;
        };

        lower_layer {
            display-name = "lower";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | CTRL | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT | STD |     |     |     |BTCLR|   |     |     |     |     |     |      |
//                    | ALT |     | ENT |   | SPC |     | ESC |
// Rightmost thumb: tap Escape, hold Raise (inherited from base).
// STD: Lower + Z unlocks ZMK Studio.
// BTCLR: hold Lower + B for one second; a short tap does nothing.
            bindings = <
&kp TAB   &kp N1         &kp N2       &kp N3       &kp N4       &kp N5             &kp N6    &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
&trans    &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4       &kp LEFT  &kp DOWN &kp UP &kp RIGHT &trans &trans
&kp LSHFT &studio_unlock &trans       &trans       &trans       &bt_clear_hold 0 0 &trans    &trans   &trans &trans    &trans &trans
                                      &trans       &trans       &kp RET            &kp SPACE &trans   &trans
            >;
        };

        raise_layer {
            display-name = "raise";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | ALT |     | ENT |   | SPC |     | ESC |
// Rightmost thumb: tap Escape, hold Raise (inherited from base).
            bindings = <
&kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
&kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                          &trans   &trans   &kp RET     &kp SPACE &trans    &trans
            >;
        };

        extra_layer0 {
            display-name = "extra_layer0";
            status = "reserved";
        };

        extra_layer1 {
            display-name = "extra_layer1";
            status = "reserved";
        };

        extra_layer2 {
            display-name = "extra_layer2";
            status = "reserved";
        };
    };
};
